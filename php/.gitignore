# ملفات التشغيل (لا تُرفع إلى Git)
storage/sessions/*
storage/logs/*
storage/private/*
storage/ratelimit/*
storage/recover-*
!storage/sessions/.gitkeep
!storage/logs/.gitkeep
!storage/private/.gitkeep
!storage/ratelimit/.gitkeep
config.local.php

# قاعدة "downloads/" في .gitignore الرئيسي (قالب Python) كانت تستثني قوالب مركز التحميلات
!app/views/downloads/

# قاعدة "media/" في .gitignore الرئيسي (قالب Django) كانت تستثني إضافة الفيديو في محرر TinyMCE
!assets/vendor/**/plugins/media/
