+    {
+        $modules = self::code128($text);
+        $quiet = 10; // هامش أبيض على الجانبين يحتاجه القارئ
+        $width = (strlen($modules) + 2 * $quiet) * $scale;
+        $textHeight = $includeText ? 14 * $scale : 0;
+        $rects = '';
+        $len = strlen($modules);
+        for ($i = 0; $i < $len; $i++) {
+            if ($modules[$i] !== '1') {
