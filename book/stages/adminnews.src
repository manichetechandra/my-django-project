@@block news-delete 39.3

function admin_delete(string $key, $id): void
{
    admin_guard();
    admin_news_only($key);
    $news = News::findOrFail($id);
    if (is_post()) {
        $image = (string) $news['main_image'];
        $news->delete();
        Upload::delete($image);
        flash('success', 'تم حذف "' . $news . '" بنجاح.');
        redirect_to('admin:list', 'news');
    }
    admin_render('delete', [
        'page_title' => 'حذف خبر',
        'r'          => ['label' => 'خبر', 'key' => 'news'], // ما يحتاجه قالب delete.php
        'obj'        => $news,
    ]);
}
@@end
