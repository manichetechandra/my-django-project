                    continue;
                }
                $data[$col] = $v === '' ? null : $v;
            }
        }

        // الصورة: نرفعها فقط إن لم يكن في الحقول الأخرى خطأ
        $file = $_FILES['main_image'] ?? null;
        if (!$errors && $file && $file['error'] !== UPLOAD_ERR_NO_FILE) {
            $max = (float) config('uploads.max_image_mb', 10);
