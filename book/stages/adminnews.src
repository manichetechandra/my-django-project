                <input type="datetime-local" name="published_date" id="f_published_date" class="form-control" value="<?= $date ? $date->format('Y-m-d\TH:i') : '' ?>">
                <?php if (isset($errors['published_date'])): ?><span class="help-block"><i class="fa fa-exclamation-circle"></i> <?= e($errors['published_date']) ?></span><?php endif; ?>
                <span class="help-block small text-muted">اتركه فارغاً ليُعتمد تاريخ الإنشاء</span>
            </div>
            <div class="form-group <?= isset($errors['status']) ? 'has-error' : '' ?>">
                <label for="f_status" class="control-label">الحالة <span class="text-danger">*</span></label>
                <select name="status" id="f_status" class="form-control">
                    <?php foreach (News::choiceMap('status') as $value => $label): ?>
                        <option value="<?= e($value) ?>"<?= ($values['status'] ?? '') === $value ? ' selected' : '' ?>><?= e($label) ?></option>
                    <?php endforeach; ?>
                </select>
                <?php if (isset($errors['status'])): ?><span class="help-block"><i class="fa fa-exclamation-circle"></i> <?= e($errors['status']) ?></span><?php endif; ?>
            </div>
            <div class="form-group">
                <div class="checkbox"><label><input type="checkbox" name="is_featured" id="f_is_featured" value="1"<?= !empty($values['is_featured']) ? ' checked' : '' ?>> خبر مميز</label></div>
            </div>
            <div class="form-group">
                <div class="checkbox"><label><input type="checkbox" name="show_in_ticker" id="f_show_in_ticker" value="1"<?= !empty($values['show_in_ticker']) ? ' checked' : '' ?>> عرض في شريط الأخبار</label></div>
            </div>
            <?php if ($tinymce): ?>
                <p class="admin-editor-source small text-muted" data-editor-source>
                    <i class="fa fa-pencil-square-o"></i> محرر النصوص: <bdi dir="ltr">TinyMCE <span data-tinymce-version></span></bdi>
                    — <?= $tinymce['bundled'] ? 'النسخة المرفقة بالمشروع' : 'نسختك' ?>: <code dir="ltr"><?= e($tinymce['path']) ?></code>
                    — الأدوات: <span data-tinymce-plugins><?= count($tinymce['plugins']) ?></span> إضافة من <?= count($tinymce['plugins']) ?> في مجلدها
                    <?php if ($tinymce['lang'] === ''): ?>(الواجهة العربية من ملفات المشروع)<?php endif; ?>
                </p>
            <?php endif; ?>
        </div>
    </div>

    <div class="admin-submit-row">
        <button type="submit" class="btn btn-success"><i class="fa fa-save"></i> حفظ</button>
        <?php if ($news): ?>
            <a href="<?= e(url('admin:delete', 'news', $news['id'])) ?>" class="btn btn-danger pull-left"><i class="fa fa-trash"></i> حذف</a>
        <?php endif; ?>
    </div>
</form>
<?php endblock(); ?>

<?php if ($tinymce): ?>
<?php $rich_schema = RichText::editorSchema(); ?>
<?php block('extra_js'); ?>
<script src="<?= e($tinymce['url']) ?>"></script>
<script src="<?= asset('js/admin-richtext.js') ?>" data-base="<?= e($tinymce['base']) ?>" data-suffix="<?= e($tinymce['suffix']) ?>"
        data-lang="<?= e($tinymce['lang']) ?>" data-lang-base="<?= e(base_url() . '/assets/js/tinymce-lang/') ?>"
        data-plugins="<?= e(implode(' ', $tinymce['plugins'])) ?>" data-upload-url="<?= e(url('admin:editor_upload')) ?>"
        data-valid-elements="<?= e($rich_schema['elements']) ?>" data-valid-styles="<?= e($rich_schema['styles']) ?>"></script>
<?php endblock(); ?>
<?php endif; ?>
@@end
@@block news-tr-partial 40.2 file=app/views/admin/_news_tr.php@40.2
<?php /* حقلا الترجمة FR و EN تحت حقل عربي — مؤقت: يكتبهما النموذج العام لكل الأقسام في الفصل 42 */ ?>
<?php $spec = admin_resources()['news']['fields'][$f]; $max = admin_translation_max($spec); ?>
<div class="admin-translations">
    <?php foreach (admin_other_langs() as $lang): $col = $f . '_' . $lang; ?>
        <div class="admin-tr-row <?= isset($errors[$col]) ? 'has-error' : '' ?>" data-lang="<?= e($lang) ?>">
            <label class="admin-tr-lang" for="f_<?= e($col) ?>" title="<?= $lang === 'fr' ? 'الفرنسية' : 'الإنجليزية' ?>"><?= e(strtoupper($lang)) ?></label>
            <?php if ($spec['type'] === 'text'): ?>
                <input type="text" name="<?= e($col) ?>" id="f_<?= e($col) ?>" class="form-control input-sm" dir="ltr" lang="<?= e($lang) ?>" value="<?= e($values[$col] ?? '') ?>"<?= $max ? ' maxlength="' . $max . '"' : '' ?> data-tr-of="<?= e($f) ?>" data-tr-lang="<?= e($lang) ?>">
            <?php else: ?>
                <textarea name="<?= e($col) ?>" id="f_<?= e($col) ?>" class="form-control input-sm" rows="3" dir="ltr" lang="<?= e($lang) ?>" data-tr-of="<?= e($f) ?>" data-tr-lang="<?= e($lang) ?>"><?= e($values[$col] ?? '') ?></textarea>
            <?php endif; ?>
        </div>
        <?php if (isset($errors[$col])): ?><span class="help-block"><i class="fa fa-exclamation-circle"></i> <?= strtoupper($lang) ?>: <?= e($errors[$col]) ?></span><?php endif; ?>
    <?php endforeach; ?>
</div>
@@end
@@block news-tr-partial-rt 41.3 replaces=news-tr-partial file=app/views/admin/_news_tr.php@41.3
<?php /* حقلا الترجمة FR و EN تحت حقل عربي — مؤقت: يكتبهما النموذج العام لكل الأقسام في الفصل 42 */ ?>
<?php $spec = admin_resources()['news']['fields'][$f]; $max = admin_translation_max($spec); ?>
<div class="admin-translations">
    <?php foreach (admin_other_langs() as $lang): $col = $f . '_' . $lang; ?>
        <div class="admin-tr-row <?= isset($errors[$col]) ? 'has-error' : '' ?>" data-lang="<?= e($lang) ?>">
            <label class="admin-tr-lang" for="f_<?= e($col) ?>" title="<?= $lang === 'fr' ? 'الفرنسية' : 'الإنجليزية' ?>"><?= e(strtoupper($lang)) ?></label>
            <?php if ($spec['type'] === 'text'): ?>
                <input type="text" name="<?= e($col) ?>" id="f_<?= e($col) ?>" class="form-control input-sm" dir="ltr" lang="<?= e($lang) ?>" value="<?= e($values[$col] ?? '') ?>"<?= $max ? ' maxlength="' . $max . '"' : '' ?> data-tr-of="<?= e($f) ?>" data-tr-lang="<?= e($lang) ?>">
            <?php elseif ($spec['type'] === 'richtext'): ?>
                <textarea name="<?= e($col) ?>" id="f_<?= e($col) ?>" class="form-control input-sm admin-richtext" rows="<?= max(3, (int) ceil(($spec['rows'] ?? 8) / 2)) ?>" dir="ltr" lang="<?= e($lang) ?>" data-richtext="<?= e($lang) ?>" data-tr-of="<?= e($f) ?>" data-tr-lang="<?= e($lang) ?>"><?= e(RichText::forEditor($values[$col] ?? '')) ?></textarea>
            <?php else: ?>
                <textarea name="<?= e($col) ?>" id="f_<?= e($col) ?>" class="form-control input-sm" rows="3" dir="ltr" lang="<?= e($lang) ?>" data-tr-of="<?= e($f) ?>" data-tr-lang="<?= e($lang) ?>"><?= e($values[$col] ?? '') ?></textarea>
            <?php endif; ?>
        </div>
        <?php if (isset($errors[$col])): ?><span class="help-block"><i class="fa fa-exclamation-circle"></i> <?= strtoupper($lang) ?>: <?= e($errors[$col]) ?></span><?php endif; ?>
    <?php endforeach; ?>
</div>
@@end
