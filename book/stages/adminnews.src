@@block news-list-view 39.1 file=app/views/admin/news_list.php@39.1
<?php extend('admin/layout'); ?>
<?php block('title'); ?><?= e($page_title) ?><?php endblock(); ?>
<?php block('content'); ?>
<div class="admin-header">
    <h1 class="admin-title"><i class="fa fa-newspaper-o"></i> الأخبار <small>(<?= count($news_list) ?>)</small></h1>
    <a href="<?= e(url('admin:add', 'news')) ?>" class="btn btn-success"><i class="fa fa-plus"></i> إضافة خبر</a>
</div>

<div class="table-responsive admin-table-wrap">
    <table class="table table-striped table-hover admin-table">
        <thead>
        <tr>
            <th>الصورة الرئيسية</th>
            <th>العنوان</th>
            <th>الحالة</th>
            <th>خبر مميز</th>
            <th>تاريخ النشر</th>
            <th>عدد المشاهدات</th>
            <th></th>
        </tr>
        </thead>
        <tbody>
        <?php foreach ($news_list as $n): ?>
            <tr>
                <td>
                    <?php if ($n['main_image']): ?>
                        <img src="<?= e(media_url($n['main_image'])) ?>" class="admin-thumb" alt="">
                    <?php else: ?>
                        <span class="text-muted">—</span>
                    <?php endif; ?>
                </td>
                <td><a href="<?= e(url('admin:edit', 'news', $n['id'])) ?>"><strong><?= e($n['title']) ?></strong></a></td>
                <td><span class="label label-default admin-choice admin-choice-<?= e($n['status']) ?>"><?= e($n->get_status_display()) ?></span></td>
                <td>
                    <?php if ($n['is_featured']): ?>
                        <i class="fa fa-check-circle text-success"></i>
                    <?php else: ?>
                        <i class="fa fa-times-circle text-danger"></i>
                    <?php endif; ?>
                </td>
                <td><?= e(format_date($n['published_date'], 'd/m/Y H:i')) ?></td>
                <td><?= e($n['views_count']) ?></td>
                <td class="text-left" style="white-space: nowrap">
                    <a href="<?= e(url('admin:edit', 'news', $n['id'])) ?>" class="btn btn-xs btn-default"><i class="fa fa-pencil"></i> تعديل</a>
                    <a href="<?= e(url('admin:delete', 'news', $n['id'])) ?>" class="btn btn-xs btn-danger"><i class="fa fa-trash"></i> حذف</a>
                </td>
            </tr>
        <?php endforeach; ?>
        <?php if (!$news_list): ?>
            <tr><td colspan="7" class="text-center text-muted" style="padding:40px">لا توجد أخبار</td></tr>
        <?php endif; ?>
        </tbody>
    </table>
</div>
<?php endblock(); ?>
@@end
@@block news-list-view-tr 40.2 replaces=news-list-view file=app/views/admin/news_list.php@40.2
<?php extend('admin/layout'); ?>
<?php block('title'); ?><?= e($page_title) ?><?php endblock(); ?>
<?php block('content'); ?>
<div class="admin-header">
    <h1 class="admin-title"><i class="fa fa-newspaper-o"></i> الأخبار <small>(<?= count($news_list) ?>)</small></h1>
    <a href="<?= e(url('admin:add', 'news')) ?>" class="btn btn-success"><i class="fa fa-plus"></i> إضافة خبر</a>
</div>

<div class="table-responsive admin-table-wrap">
    <table class="table table-striped table-hover admin-table">
        <thead>
        <tr>
            <th>الصورة الرئيسية</th>
            <th>العنوان</th>
            <th>الحالة</th>
            <th>خبر مميز</th>
            <th>تاريخ النشر</th>
            <th>عدد المشاهدات</th>
            <th></th>
        </tr>
        </thead>
        <tbody>
        <?php $r = admin_resources()['news']; // لشارات الترجمة FR و EN تحت كل عنوان ?>
        <?php foreach ($news_list as $n): ?>
            <tr>
                <td>
                    <?php if ($n['main_image']): ?>
                        <img src="<?= e(media_url($n['main_image'])) ?>" class="admin-thumb" alt="">
                    <?php else: ?>
                        <span class="text-muted">—</span>
                    <?php endif; ?>
                </td>
                <td>
                    <a href="<?= e(url('admin:edit', 'news', $n['id'])) ?>"><strong><?= e($n['title']) ?></strong></a>
                    <div class="admin-tr-badges">
                        <?php foreach (admin_translation_status($r, $n) as $lang => $complete): ?>
                            <span class="admin-tr-badge <?= $complete ? 'is-done' : 'is-missing' ?>" title="<?= $complete ? 'مترجم' : 'تنقصه ترجمة: يظهر النص العربي مكانها' ?>"><?= e(strtoupper($lang)) ?></span>
                        <?php endforeach; ?>
                    </div>
                </td>
                <td><span class="label label-default admin-choice admin-choice-<?= e($n['status']) ?>"><?= e($n->get_status_display()) ?></span></td>
                <td>
                    <?php if ($n['is_featured']): ?>
                        <i class="fa fa-check-circle text-success"></i>
                    <?php else: ?>
                        <i class="fa fa-times-circle text-danger"></i>
                    <?php endif; ?>
                </td>
                <td><?= e(format_date($n['published_date'], 'd/m/Y H:i')) ?></td>
                <td><?= e($n['views_count']) ?></td>
                <td class="text-left" style="white-space: nowrap">
                    <a href="<?= e(url('admin:edit', 'news', $n['id'])) ?>" class="btn btn-xs btn-default"><i class="fa fa-pencil"></i> تعديل</a>
                    <a href="<?= e(url('admin:delete', 'news', $n['id'])) ?>" class="btn btn-xs btn-danger"><i class="fa fa-trash"></i> حذف</a>
                </td>
            </tr>
        <?php endforeach; ?>
        <?php if (!$news_list): ?>
            <tr><td colspan="7" class="text-center text-muted" style="padding:40px">لا توجد أخبار</td></tr>
        <?php endif; ?>
        </tbody>
    </table>
</div>
<?php endblock(); ?>
@@end
