                <?php if (isset($errors['title'])): ?><span class="help-block"><i class="fa fa-exclamation-circle"></i> <?= e($errors['title']) ?></span><?php endif; ?>
            </div>
            <div class="form-group <?= isset($errors['slug']) ? 'has-error' : '' ?>">
                <label for="f_slug" class="control-label">الرابط (slug)</label>
                <input type="text" name="slug" id="f_slug" class="form-control" dir="ltr" value="<?= e($values['slug'] ?? '') ?>" data-slug-from="f_title"<?= $news ? ' data-slug-locked="1"' : '' ?>>
                <?php if (isset($errors['slug'])): ?><span class="help-block"><i class="fa fa-exclamation-circle"></i> <?= e($errors['slug']) ?></span><?php endif; ?>
                <span class="help-block small text-muted">يُولَّد تلقائياً من "العنوان" إذا تُرك فارغاً.</span>
            </div>
            <div class="form-group">
                <label for="f_summary" class="control-label">الملخص</label>
                <textarea name="summary" id="f_summary" class="form-control" rows="3"><?= e($values['summary'] ?? '') ?></textarea>
            </div>
            <div class="form-group <?= isset($errors['content']) ? 'has-error' : '' ?>">
                <label for="f_content" class="control-label">المحتوى <span class="text-danger">*</span></label>
                <textarea name="content" id="f_content" class="form-control" rows="8"><?= e($values['content'] ?? '') ?></textarea>
                <?php if (isset($errors['content'])): ?><span class="help-block"><i class="fa fa-exclamation-circle"></i> <?= e($errors['content']) ?></span><?php endif; ?>
            </div>
            <div class="form-group <?= isset($errors['main_image']) ? 'has-error' : '' ?>">
                <label for="f_main_image" class="control-label">الصورة الرئيسية</label>
                <?php if ($news && $news['main_image']): ?>
                    <div class="admin-current-file">
                        <img src="<?= e(media_url($news['main_image'])) ?>" class="admin-preview" alt="">
                    </div>
                <?php endif; ?>
                <input type="file" name="main_image" id="f_main_image" class="form-control" accept="image/*">
                <?php if (isset($errors['main_image'])): ?><span class="help-block"><i class="fa fa-exclamation-circle"></i> <?= e($errors['main_image']) ?></span><?php endif; ?>
            </div>
            <?php $date = to_datetime($values['published_date'] ?? null); ?>
