@@block sliders 14
-- صور السلايدر
INSERT INTO `sliders` (`title`, `subtitle`, `image`, `order`) VALUES
('مرحباً بكم في مديرية الخدمات الجامعية سطيف', 'في خدمة الطالب: الإيواء، الإطعام، النقل والمنح', 'slider/slide-1.jpg', 1),
('انطلاق التسجيلات في الإقامات الجامعية', 'الموسم الجامعي 2026/2027 — قدّم طلبك من فضاء الطالب', 'slider/slide-2.jpg', 2),
('مطاعم جامعية بوجبات متوازنة', 'ثلاث وجبات يومياً بأسعار رمزية', 'slider/slide-3.jpg', 3);

@@end
@@block news 14
-- الأخبار (show_in_ticker = 1 يعني: يظهر في الشريط المتحرك)
INSERT INTO `news` (`title`, `slug`, `summary`, `content`, `main_image`, `published_date`, `views_count`, `is_featured`, `show_in_ticker`, `order`) VALUES
('صرف الشطر الأول من المنحة الجامعية', 'sarf-al-minha',
 'انطلقت عملية صرف الشطر الأول من المنحة الجامعية لفائدة الطلبة المستحقين عبر حساباتهم البريدية.',
 'تعلم مديرية الخدمات الجامعية لولاية سطيف كافة الطلبة الممنوحين بانطلاق صرف الشطر الأول من المنحة الجامعية. يمكن سحب المبلغ من الحساب البريدي الجاري ابتداءً من يوم الأحد.',
 'news/main/bourse.jpg', '2026-10-12 09:00:00', 512, 1, 1, 1),
('تدشين مكتبة جديدة بالإقامة الجامعية دباغين', 'maktaba-jadida',
 'دُشّنت مكتبة جديدة مجهزة بقاعة مطالعة تتسع لمئة وعشرين طالباً.',
 'في إطار تحسين ظروف المراجعة، دُشّنت مكتبة جديدة بالإقامة الجامعية دباغين، مجهزة بقاعة مطالعة تتسع لمئة وعشرين طالباً وبأكثر من ثلاثة آلاف عنوان.',
 'news/main/bibliotheque.jpg', '2026-10-05 10:30:00', 130, 1, 0, 0),
('تعزيز خطوط النقل الجامعي نحو القطب الجامعي الباز', 'naql-jamii',
 'أُضيفت حافلات جديدة لتقليص مدة الانتظار في أوقات الذروة.',
 'تعزيزاً لخدمة النقل الجامعي، أضيفت حافلات جديدة على الخطوط المؤدية إلى القطب الجامعي الباز لتقليص مدة الانتظار في أوقات الذروة.',
 'news/main/transport.jpg', '2026-09-20 08:00:00', 98, 0, 0, 0),
('قائمة الوجبات الأسبوعية في المطاعم الجامعية', 'qaimat-al-wajabat',
 'تعرّف على قائمة الوجبات المقدمة هذا الأسبوع في كل المطاعم الجامعية.',
 'تنشر مصلحة الإطعام قائمة الوجبات الأسبوعية المقدمة في المطاعم الجامعية، مع مراعاة التوازن الغذائي وتنوع الأطباق.',
 'news/main/menu.jpg', '2026-09-15 12:00:00', 76, 0, 0, 0),
('انطلاق التسجيلات في الإقامات الجامعية للموسم 2026/2027', 'tasjilat-al-iqamat',
 'يمكن للطلبة الجدد والقدامى إيداع طلبات الإيواء عبر فضاء الطالب.',
 'تعلن المديرية عن انطلاق التسجيلات في الإقامات الجامعية للموسم 2026/2027. يودع الطالب طلبه عبر فضاء الطالب مرفقاً بالوثائق المطلوبة.',
 'news/main/inscription.jpg', '2026-09-01 08:30:00', 245, 1, 1, 2);

@@end
@@block activities 14
-- النشاطات (is_featured = 1 يعني: تظهر في الصفحة الرئيسية)
INSERT INTO `activities` (`title`, `slug`, `activity_type`, `short_description`, `description`, `main_image`, `date`, `location`, `participants_count`, `is_featured`) VALUES
('دورة كرة القدم بين الإقامات الجامعية', 'dawrat-korat-al-qadam', 'sport',
 'دورة رياضية تجمع فرق الإقامات الجامعية لولاية سطيف في أجواء أخوية بمشاركة أكثر من عشرين فريقاً.',
 'دورة رياضية تجمع فرق الإقامات الجامعية لولاية سطيف في أجواء أخوية بمشاركة أكثر من عشرين فريقاً.',
 'activities/main/football.jpg', '2026-10-20', 'الملعب الجامعي الباز', 240, 1),
('أمسية شعرية بمناسبة يوم الطالب', 'umsiya-shiriya', 'culture',
 'أمسية أدبية يلقي فيها الطلبة قصائدهم ويتنافسون على جائزة أفضل قصيدة.',
 'أمسية أدبية يلقي فيها الطلبة قصائدهم ويتنافسون على جائزة أفضل قصيدة.',
 'activities/main/poesie.jpg', '2026-10-02', 'قاعة المحاضرات، إقامة دباغين', 150, 1),
('معرض الكتاب الجامعي', 'maarad-al-kitab', 'scientific',
 'معرض يضم آلاف العناوين في مختلف التخصصات بأسعار مخفضة للطلبة.',
 'معرض يضم آلاف العناوين في مختلف التخصصات بأسعار مخفضة للطلبة.',
 'activities/main/salon-livre.jpg', '2026-09-28', 'المكتبة المركزية', 400, 1);

@@end
@@block departements 14
-- أقسام المديرية
INSERT INTO `departements` (`name`, `slug`, `description`, `image`, `order`) VALUES
('مصلحة المنح', 'maslahat-al-minah',
 'تتكفل بدراسة ملفات المنحة الجامعية وصرفها للطلبة المستحقين، ومتابعة الطعون والتحويلات بين الولايات.',
 'departements/bourses.jpg', 1),
('مصلحة الإيواء', 'maslahat-al-iwaa',
 'تنظم عملية الإيواء في الإقامات الجامعية: التسجيل، توزيع الغرف، ومتابعة ظروف الإقامة.',
 'departements/hebergement.jpg', 2),
('مصلحة الإطعام', 'maslahat-al-itaam',
 'تشرف على المطاعم الجامعية وتسهر على جودة الوجبات المقدمة وتوازنها الغذائي.',
 'departements/restauration.jpg', 3),
('مصلحة النقل', 'maslahat-al-naql',
 'تسيّر خطوط النقل الجامعي التي تربط الأحياء والإقامات بالأقطاب الجامعية.',
 'departements/transport.jpg', 4);

@@end
