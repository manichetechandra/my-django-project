@@block php-db 15 replaces=php-arrays
// ---------------------------------------------- الاتصال بقاعدة البيانات
$config = require __DIR__ . '/config.php';
$db = $config['db'];

$pdo = new PDO(
    "mysql:host={$db['host']};port={$db['port']};dbname={$db['name']};charset={$db['charset']}",
    $db['user'],
    $db['password'],
    [
        PDO::ATTR_ERRMODE            => PDO::ERRMODE_EXCEPTION,
        PDO::ATTR_DEFAULT_FETCH_MODE => PDO::FETCH_ASSOC,
    ]
);

// ---------------------------------------------- جلب بيانات كل قسم
$slider_images = $pdo->query(
    "SELECT * FROM sliders WHERE is_active = 1 ORDER BY `order`, created_at DESC LIMIT 4"
)->fetchAll();

$ticker_news = $pdo->query(
    "SELECT * FROM news WHERE status = 'published' AND show_in_ticker = 1 ORDER BY `order` LIMIT 2"
)->fetchAll();

$latest_news = $pdo->query(
    "SELECT * FROM news WHERE status = 'published' ORDER BY published_date DESC LIMIT 5"
)->fetchAll();

$featured_activities = $pdo->query(
    "SELECT * FROM activities WHERE is_active = 1 AND is_featured = 1 ORDER BY `date` DESC LIMIT 3"
)->fetchAll();

$departements_list = $pdo->query(
    "SELECT * FROM departements WHERE is_active = 1 ORDER BY `order`, name LIMIT 4"
)->fetchAll();

$cites_list = $pdo->query(
    "SELECT * FROM cites WHERE is_active = 1 ORDER BY `order`, name LIMIT 12"
)->fetchAll();

// أرقام الإحصائيات: نعدّ الأخبار والإقامات من قاعدة البيانات، والباقي مؤقتاً كما كان
$site_stats = [
    'total_visitors'   => 15230,
    'total_page_views' => 48975,
    'total_news'       => (int) $pdo->query("SELECT COUNT(*) FROM news WHERE status = 'published'")->fetchColumn(),
    'total_services'   => 12,
    'total_downloads'  => 8,
    'total_faqs'       => 15,
    'total_cites'      => (int) $pdo->query("SELECT COUNT(*) FROM cites WHERE is_active = 1")->fetchColumn(),
];
@@end
