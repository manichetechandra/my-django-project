@@block list-main 35 file=admin-demo/list.html@35
    <div class="admin-header">
        <h1 class="admin-title"><i class="fa fa-newspaper-o"></i> الأخبار <small>(12)</small></h1>
        <a href="form.html" class="btn btn-success"><i class="fa fa-plus"></i> إضافة خبر</a>
    </div>

    <div class="row">
        <div class="col-md-9">
            <form method="get" class="admin-search">
                <div class="input-group">
                    <input type="text" name="q" class="form-control" placeholder="بحث...">
                    <span class="input-group-btn"><button class="btn btn-default" type="submit"><i class="fa fa-search"></i> بحث</button></span>
                </div>
            </form>

            <form method="post" id="admin-list-form">
                <div class="admin-actions form-inline">
                    <select name="action" class="form-control input-sm">
                        <option value="">— اختر إجراءً —</option>
                        <option value="publish">نشر الأخبار المحددة</option>
                        <option value="draft">تحويل إلى مسودة</option>
                        <option value="feature">تمييز الأخبار المحددة</option>
                        <option value="delete">🗑 حذف السجلات المحددة</option>
                    </select>
                    <button type="submit" class="btn btn-sm btn-default" data-confirm-delete>تنفيذ</button>
                    <span class="text-muted small" data-selected-count></span>
                </div>

                <div class="table-responsive admin-table-wrap">
                    <table class="table table-striped table-hover admin-table">
                        <thead>
                        <tr>
                            <th style="width:30px"><input type="checkbox" data-select-all></th>
                            <th>الصورة الرئيسية</th>
                            <th>العنوان</th>
                            <th>الكاتب</th>
                            <th>الحالة</th>
                            <th>خبر مميز</th>
                            <th>عرض في شريط الأخبار</th>
                            <th>تاريخ النشر</th>
                            <th>عدد المشاهدات</th>
                        </tr>
                        </thead>
                        <tbody>
                        <tr>
                            <td><input type="checkbox" name="ids[]" value="1" data-row-check></td>
                            <td><img src="../uploads/news/main/bourse.jpg" class="admin-thumb" alt=""></td>
                            <td><a href="form.html"><strong>صرف الشطر الأول من المنحة الجامعية</strong></a></td>
                            <td>miloudsellam</td>
                            <td><span class="label label-default admin-choice admin-choice-published">منشور</span></td>
                            <td><input type="checkbox" name="edit[1][is_featured]" value="1" checked data-editable></td>
                            <td><input type="checkbox" name="edit[1][show_in_ticker]" value="1" checked data-editable></td>
                            <td>28/10/2026 10:00</td>
                            <td>412</td>
                        </tr>
                        <tr>
                            <td><input type="checkbox" name="ids[]" value="2" data-row-check></td>
                            <td><img src="../uploads/news/main/bibliotheque.jpg" class="admin-thumb" alt=""></td>
                            <td><a href="form.html"><strong>تمديد ساعات فتح المكتبات في الإقامات</strong></a></td>
                            <td>miloudsellam</td>
                            <td><span class="label label-default admin-choice admin-choice-published">منشور</span></td>
                            <td><input type="checkbox" name="edit[2][is_featured]" value="1" data-editable></td>
                            <td><input type="checkbox" name="edit[2][show_in_ticker]" value="1" checked data-editable></td>
                            <td>25/10/2026 09:30</td>
                            <td>198</td>
                        </tr>
                        <tr>
                            <td><input type="checkbox" name="ids[]" value="3" data-row-check></td>
                            <td><img src="../uploads/news/main/transport.jpg" class="admin-thumb" alt=""></td>
                            <td><a href="form.html"><strong>خطوط جديدة للنقل الجامعي</strong></a></td>
                            <td>hicham41</td>
                            <td><span class="label label-default admin-choice admin-choice-draft">مسودة</span></td>
                            <td><input type="checkbox" name="edit[3][is_featured]" value="1" data-editable></td>
                            <td><input type="checkbox" name="edit[3][show_in_ticker]" value="1" data-editable></td>
                            <td>20/10/2026 14:00</td>
                            <td>0</td>
                        </tr>
                        </tbody>
                    </table>
                </div>
                <button type="submit" name="save_list" value="1" class="btn btn-primary"><i class="fa fa-save"></i> حفظ التعديلات</button>
            </form>

            <nav class="text-center">
                <ul class="pagination">
                    <li class="active"><span>1</span></li>
                    <li><a href="#">2</a></li>
                    <li><a href="#">التالي &laquo;</a></li>
                </ul>
            </nav>
        </div>

        <div class="col-md-3">
            <div class="panel panel-default admin-panel admin-filters">
                <div class="panel-heading"><strong><i class="fa fa-filter"></i> تصفية</strong></div>
                <div class="panel-body">
                    <h5>الحالة</h5>
                    <ul class="list-unstyled">
                        <li><a href="#" class="active">الكل</a></li>
                        <li><a href="#">مسودة</a></li>
                        <li><a href="#">منشور</a></li>
                        <li><a href="#">مؤرشف</a></li>
                    </ul>
                    <h5>خبر مميز</h5>
                    <ul class="list-unstyled">
                        <li><a href="#" class="active">الكل</a></li>
                        <li><a href="#">نعم</a></li>
                        <li><a href="#">لا</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
@@end
