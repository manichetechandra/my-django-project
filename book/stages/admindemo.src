@@block form-main 35 file=admin-demo/form.html@35
    <ol class="breadcrumb">
        <li><a href="index.html">لوحة الإدارة</a></li>
        <li><a href="list.html">الأخبار</a></li>
        <li class="active">إضافة</li>
    </ol>
    <h1 class="admin-title"><i class="fa fa-newspaper-o"></i> إضافة خبر</h1>

    <form method="post" enctype="multipart/form-data" class="admin-form" novalidate>
        <div class="panel panel-default admin-panel">
            <div class="panel-body">
                <div class="form-group">
                    <label for="f_title" class="control-label">العنوان <span class="text-danger">*</span></label>
                    <input type="text" name="title" id="f_title" class="form-control" maxlength="300">
                </div>
                <div class="form-group">
                    <label for="f_slug" class="control-label">الرابط (slug)</label>
                    <input type="text" name="slug" id="f_slug" class="form-control" dir="ltr" data-slug-from="f_title">
                    <span class="help-block small text-muted">يُولَّد تلقائياً من "العنوان" إذا تُرك فارغاً.</span>
                </div>
                <div class="form-group">
                    <label for="f_summary" class="control-label">الملخص</label>
                    <textarea name="summary" id="f_summary" class="form-control" rows="3"></textarea>
                </div>
                <div class="form-group">
                    <label for="f_content" class="control-label">المحتوى <span class="text-danger">*</span></label>
                    <textarea name="content" id="f_content" class="form-control" rows="8"></textarea>
                </div>
                <div class="form-group has-error">
                    <label for="f_main_image" class="control-label">الصورة الرئيسية</label>
                    <input type="file" name="main_image" id="f_main_image" class="form-control" accept="image/*">
                    <span class="help-block"><i class="fa fa-exclamation-circle"></i> نوع الملف غير مسموح.</span>
                </div>
                <div class="form-group">
                    <label for="f_published_date" class="control-label">تاريخ النشر</label>
                    <input type="datetime-local" name="published_date" id="f_published_date" class="form-control" value="2026-10-29T10:00">
                    <span class="help-block small text-muted">اتركه فارغاً ليُعتمد تاريخ الإنشاء</span>
                </div>
                <div class="form-group">
                    <label for="f_status" class="control-label">الحالة <span class="text-danger">*</span></label>
                    <select name="status" id="f_status" class="form-control">
                        <option value="draft">مسودة</option>
                        <option value="published" selected>منشور</option>
                        <option value="archived">مؤرشف</option>
                    </select>
                </div>
                <div class="form-group">
                    <div class="checkbox"><label><input type="checkbox" name="is_featured" id="f_is_featured" value="1"> خبر مميز</label></div>
                </div>
                <div class="form-group">
                    <div class="checkbox"><label><input type="checkbox" name="show_in_ticker" id="f_show_in_ticker" value="1"> عرض في شريط الأخبار</label></div>
                </div>
            </div>
        </div>

        <div class="admin-submit-row">
            <button type="submit" class="btn btn-success"><i class="fa fa-save"></i> حفظ</button>
            <button type="submit" name="_continue" value="1" class="btn btn-default">حفظ ومتابعة التعديل</button>
            <button type="submit" name="_addanother" value="1" class="btn btn-default">حفظ وإضافة آخر</button>
        </div>
    </form>
@@end
@@block form-bottom 35 file=admin-demo/form.html@35
</main>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@3.4.1/dist/js/bootstrap.min.js"></script>
<script src="../assets/js/admin.js"></script>
</body>
</html>
@@end
