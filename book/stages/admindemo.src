        <a href="#"><i class="fa fa-dashboard"></i> <span class="hidden-xs">متابعة الطلبات</span></a>
        <span class="admin-user"><i class="fa fa-user-circle"></i> ميلود سلام</span>
        <a href="#" title="تغيير كلمة المرور"><i class="fa fa-key"></i></a>
        <a href="#" title="تسجيل الخروج"><i class="fa fa-sign-out"></i></a>
